{
  "mcpServers": {
    "aptitude": {
      "command": "uvx",
      "args": ["aptitude-resolver", "mcp"],
      "env_vars": ["APTITUDE_READ_TOKEN"]
    },
    "aptitude-publisher": {
      "command": "uvx",
      "args": ["aptitude-publisher", "mcp"],
      "env_vars": [
        "APTITUDE_PUBLISH_TOKEN",
        "APTITUDE_READ_TOKEN",
        "APTITUDE_REGISTRY_URL"
      ]
    }
  }
}
