{
  "name": "aptitude",
  "version": "0.1.7",
  "description": "Inspect or publish local skills; inspect or install registry skills.",
  "author": {
    "name": "Aptitude",
    "url": "https://aptitude-registry.dev"
  },
  "homepage": "https://aptitude-registry.dev",
  "repository": "https://github.com/aptitude-stack/plugin",
  "license": "MIT",
  "keywords": ["aptitude", "skills", "mcp", "publishing"],
  "skills": "./skills/",
  "mcpServers": "./.mcp.json",
  "interface": {
    "displayName": "Aptitude",
    "shortDescription": "Inspect, publish, and install skills",
    "longDescription": "Use Aptitude's released resolver and publisher MCPs to discover, install, and publish skills with explicit review before writes.",
    "developerName": "Aptitude",
    "category": "Productivity",
    "capabilities": ["Interactive", "Read", "Write"],
    "websiteURL": "https://aptitude-registry.dev",
    "privacyPolicyURL": "https://github.com/aptitude-stack/plugin/blob/main/PRIVACY.md",
    "termsOfServiceURL": "https://github.com/aptitude-stack/plugin/blob/main/TERMS.md",
    "defaultPrompt": [
      "Inspect a local skill before publishing",
      "Publish a local skill to Aptitude",
      "Inspect a registry skill before installing",
      "Find and install an Aptitude skill"
    ],
    "brandColor": "#3775A9",
    "composerIcon": "./assets/profile-logo.png",
    "logo": "./assets/profile-logo.png"
  }
}
